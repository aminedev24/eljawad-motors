{
    "name": "eljawad-motors",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev -p 3000",
        "dev:xampp": "set NEXT_PUBLIC_DEV_API=http://localhost/eljawad-motors/server && next dev -p 3000",
        "dev:php": "cross-env NEXT_PUBLIC_DEV_API=http://localhost:8080/server next dev -p 3000",
        "php": "php -S localhost:8080",
        "dev:full": "php -S localhost:8080 -t . & sleep 1 && cross-env NEXT_PUBLIC_DEV_API=http://localhost:8080/server next dev -p 3000",
        "build": "next build",
        "lint": "next lint",
        "predeploy": "npm run build && next export -o docs && touch docs/.nojekyll",
        "deploy": "gh-pages -d out"
    },
    "dependencies": {
        "@capacitor/android": "^8.0.2",
        "@capacitor/cli": "^8.0.2",
        "@capacitor/core": "^8.0.2",
        "@fortawesome/fontawesome-free": "^6.7.2",
        "@fortawesome/fontawesome-svg-core": "^6.6.0",
        "@fortawesome/free-solid-svg-icons": "^6.6.0",
        "@fortawesome/react-fontawesome": "^0.2.2",
        "@heroicons/react": "^2.2.0",
        "@react-pdf/renderer": "^4.1.6",
        "axios": "^1.7.7",
        "car-makes-icons": "^1.0.0",
        "dompurify": "^3.4.12",
        "email-addresses": "^5.0.0",
        "file-saver": "^2.0.5",
        "html-react-parser": "^5.2.2",
        "lucide-react": "^0.469.0",
        "next": "15.3.3",
        "react": "^19.0.0",
        "react-country-flag": "^3.1.0",
        "react-dom": "^19.0.0",
        "react-draggable": "^4.4.6",
        "react-icons": "^5.3.0",
        "react-markdown": "^10.1.0",
        "react-pdf": "^9.2.1",
        "react-select": "^5.10.1",
        "react-slick": "^0.30.2",
        "remark-gfm": "^4.0.1",
        "slick-carousel": "^1.8.1",
        "swiper": "^12.0.3",
        "uuid": "^11.1.0",
        "web-vitals": "^2.1.4",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@types/node": "26.2.0",
        "@types/react": "19.2.14",
        "autoprefixer": "^10.4.21",
        "cross-env": "^10.1.0",
        "eslint": "^10.1.0",
        "file-loader": "^6.2.0",
        "postcss": "^8.5.5",
        "responsive-loader": "^3.1.2",
        "sharp": "^0.34.2",
        "tailwindcss": "^3.4.17",
        "typescript": "5.9.3",
        "webpack-loader": "^0.0.1"
    }
}
